{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "vscode", "mocha"]
  },
  "include": [
    "src/shared",
    "src/core",
    "src/vscode",
    "test",
    "scripts",
    "*.config.ts",
    "*.config.mts",
    "*.config.mjs",
    "esbuild.mjs",
    ".vscode-test.mjs"
  ],
  "exclude": ["test/fixtures", "node_modules", "dist", "dist-test"]
}
